# ============================================
# SERVER
# ============================================
PORT=3000
NODE_ENV=production

# ============================================
# SECURITY
# ============================================
API_KEY=your_strong_api_key_here_min_32_chars
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret

# ============================================
# GOOGLE SHEETS
# ============================================
GOOGLE_SERVICE_ACCOUNT_EMAIL=dental-ai@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your_google_spreadsheet_id_here

# ============================================
# GMAIL (OAuth2)
# ============================================
GMAIL_CLIENT_ID=your_gmail_oauth_client_id
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token
GMAIL_FROM_ADDRESS=your_gmail@gmail.com
GMAIL_FROM_NAME=Sarah - California Dental Specialty Group

# ============================================
# CLINIC STAFF NOTIFICATIONS
# ============================================
STAFF_EMAIL=office@californiadentalspecialtygroup.com
STAFF_EMERGENCY_EMAIL=emergency@californiadentalspecialtygroup.com
STAFF_PHONE=+14087499888

# ============================================
# CLINIC INFO
# ============================================
CLINIC_NAME=California Dental Specialty Group
CLINIC_PHONE=+1 408-749-9888
CLINIC_ADDRESS=500 E Remington Dr Suite 19, Sunnyvale, California 94087
CLINIC_WEBSITE=https://sunnyvaledentalspecialty.com

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
